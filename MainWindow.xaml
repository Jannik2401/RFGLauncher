<Window x:Class="BetaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BetaLauncher"
        mc:Ignorable="d"
        Title="RFG Beta Launcher" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0,20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Header Style (Dunkel) -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- ComboBox / Dropdown dunkles Design (gegen das weiße Problem) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Left Sidebar -->
        <Border Grid.Column="0" Background="#020617" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,20,10,20">
                <StackPanel DockPanel.Dock="Top">
                    <!-- Titel mit Farbverlauf Rot zu Blau -->
                    <TextBlock Text="RFG LAUNCHER" FontSize="18" FontWeight="Bold" Margin="10,0,0,20">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EF4444" Offset="0.0"/>
                                <GradientStop Color="#38BDF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <Button Content="Home" Style="{StaticResource NavButtonStyle}" Click="HomeButton_Click"/>
                    <Button Content="Updates" Style="{StaticResource NavButtonStyle}" Click="UpdatesButton_Click"/>
                    <Button Content="Account" Style="{StaticResource NavButtonStyle}" Click="AccountButton_Click"/>
                    <Button x:Name="AdminMenuButton" Content="Admin Panel" Style="{StaticResource NavButtonStyle}" Click="AdminButton_Click" Visibility="Collapsed"/>
                    <Button Content="Performance" Style="{StaticResource NavButtonStyle}" Click="PerformanceButton_Click"/>
                    <Button Content="Credits" Style="{StaticResource NavButtonStyle}" Click="CreditsButton_Click"/>
                    <Button Content="Einstellungen" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock x:Name="LauncherVersionText" Text="Version: 1.0.0" Foreground="#64748B" FontSize="12" Margin="10,0,0,10"/>
                    <Button Content="Beenden" Style="{StaticResource NavButtonStyle}" Click="ExitButton_Click" Foreground="#E11D48"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="30">

            <!-- HOME PAGE -->
            <Grid x:Name="HomePage" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Realistic Funfair Games" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EF4444" Offset="0.0"/>
                                <GradientStop Color="#38BDF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="HomeVersionText" Text="Version 1.0.0" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <Border Background="#1E293B" CornerRadius="12" Padding="25" Width="400" Margin="0,0,0,30">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Spiel-Status:" Foreground="#94A3B8" FontSize="14"/>
                                <TextBlock x:Name="HomeStatusText" Text="PRÜFE..." Foreground="#38BDF8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Beta-Zugang:" Foreground="#94A3B8" FontSize="14"/>
                                <TextBlock x:Name="HomeBetaAccessText" Text="PRÜFE..." Foreground="#38BDF8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="StartButton" Content="SPIEL STARTEN" Style="{StaticResource ActionButtonStyle}" Height="50" Width="250" FontSize="16" Click="StartButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- UPDATES PAGE -->
            <Grid x:Name="UpdatesPage" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                        <TextBlock Text="Spiel-Updates" FontSize="24" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="VersionText" Text="Installiert: Keine" Foreground="#94A3B8"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                        <ProgressBar x:Name="Progress" Height="8" Background="#1E293B" Foreground="#0284C7" Margin="0,0,0,15"/>
                        <Grid>
                            <TextBlock x:Name="StatusText" Text="Bereit" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="UpdateButton" Content="Prüfen &amp; Updaten" Style="{StaticResource ActionButtonStyle}" Click="UpdateButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Background="#1E293B" CornerRadius="8" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ReleaseNotesText" Text="Lade Release Notes..." TextWrapping="Wrap" Foreground="#CBD5E1"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ACCOUNT PAGE -->
            <Grid x:Name="AccountPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                    <TextBlock Text="Anmelden" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Benutzername" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <TextBox x:Name="AccountUsernameTextBox" Height="40" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="10,0,10,0" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Passwort" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="AccountPasswordBox" Height="40" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="10,0,10,0" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <Button x:Name="AccountLoginButton" Content="Einloggen" Style="{StaticResource ActionButtonStyle}" Click="LoginAccountButton_Click" Margin="0,0,0,15"/>

                    <TextBlock x:Name="AccountStatusText" Text="" Foreground="#E11D48" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- CHANGE PASSWORD PAGE -->
            <Grid x:Name="ChangePasswordPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                    <TextBlock Text="Passwort ändern" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bitte vergebe ein neues Passwort für deinen Account." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Neues Passwort" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="NewPasswordBox" Height="40" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="10,0,10,0" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Passwort bestätigen" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Padding="10,0,10,0" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <Button Content="Speichern" Style="{StaticResource ActionButtonStyle}" Click="SaveNewPasswordButton_Click" Margin="0,0,0,15"/>

                    <TextBlock x:Name="ChangePasswordStatusText" Text="" Foreground="#E11D48" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ADMIN PAGE -->
            <Grid x:Name="AdminPage" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Admin Panel" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- User Creation Form -->
                    <Border DockPanel.Dock="Top" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Benutzername" Foreground="#94A3B8" FontSize="12"/>
                                <TextBox x:Name="AdminNewUsernameBox" Width="150" Height="35" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Padding="8,0,8,0" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Temp-Passwort" Foreground="#94A3B8" FontSize="12"/>
                                <TextBox x:Name="AdminNewTempPassBox" Width="150" Height="35" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Padding="8,0,8,0" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Rolle" Foreground="#94A3B8" FontSize="12"/>
                                <ComboBox x:Name="AdminRoleComboBox" Width="100" Height="35" Background="#1E293B" Foreground="#F8FAFC" SelectedIndex="0">
                                    <ComboBoxItem Content="User"/>
                                    <ComboBoxItem Content="Admin"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Content="Erstellen" Style="{StaticResource ActionButtonStyle}" Height="35" VerticalAlignment="Bottom" Click="AdminCreateUser_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="AdminActionStatus" DockPanel.Dock="Bottom" Text="" Foreground="#38BDF8" Margin="0,10,0,0"/>

                    <DataGrid x:Name="UsersDataGrid" AutoGenerateColumns="False" Background="#1E293B" RowBackground="#0F172A" AlternatingRowBackground="#1E293B" Foreground="#F8FAFC" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Rolle" Binding="{Binding Role}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Beta" Binding="{Binding HasBetaAccess}" Width="50"/>
                            <DataGridCheckBoxColumn Header="Gesperrt" Binding="{Binding IsLocked}" Width="60"/>
                            <DataGridTemplateColumn Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Beta" Click="AdminToggleBeta_Click" Margin="2" Padding="5,2,5,2"/>
                                            <Button Content="Reset" Click="AdminResetPw_Click" Margin="2" Padding="5,2,5,2"/>
                                            <Button Content="Sperren" Click="AdminToggleLock_Click" Margin="2" Padding="5,2,5,2"/>
                                            <Button Content="Löschen" Click="AdminDeleteUser_Click" Foreground="#E11D48" Margin="2" Padding="5,2,5,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- PERFORMANCE PAGE -->
            <Grid x:Name="PerformancePage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="System Auslastung" FontSize="24" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                    <Border Background="#1E293B" CornerRadius="12" Padding="30" Width="300">
                        <StackPanel>
                            <TextBlock x:Name="CpuText" Text="CPU: --%" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,15"/>
                            <TextBlock x:Name="RamText" Text="RAM: --%" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- CREDITS PAGE -->
            <Grid x:Name="CreditsPage" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                    <TextBlock Text="Credits &amp; Social Media" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Scripter" FontSize="14" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Crazyfunworld Jannik, Blaubeerteilchen" FontSize="16" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,15" TextAlignment="Center" TextWrapping="Wrap"/>

                                <TextBlock Text="Modellierer" FontSize="14" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Greentiger, Blaubeerteilchen, Felixgame21" FontSize="16" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,15" TextAlignment="Center" TextWrapping="Wrap"/>

                                <TextBlock Text="Discord Beauftragter" FontSize="14" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Elias_2x9" FontSize="16" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,15" TextAlignment="Center" TextWrapping="Wrap"/>

                                <TextBlock Text="Special Thank" FontSize="14" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="DomeHD" FontSize="16" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Discord" Style="{StaticResource ActionButtonStyle}" Click="DiscordButton_Click" Margin="5"/>
                        <Button Content="Twitch" Style="{StaticResource ActionButtonStyle}" Click="TwitchButton_Click" Margin="5"/>
                        <Button Content="Instagram" Style="{StaticResponse ActionButtonStyle}" Click="InstagramButton_Click" Margin="5"/>
                        <Button Content="TikTok" Style="{StaticResponse ActionButtonStyle}" Click="TikTokButton_Click" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SETTINGS PAGE -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <StackPanel Margin="20">
                    <TextBlock Text="Launcher Einstellungen" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Launcher Updates" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="LauncherUpdateStatusText" Text="Suche nach Updates..." Foreground="#94A3B8" Margin="0,0,0,15"/>
                            <Button x:Name="CheckLauncherUpdateButton" Content="Nach Launcher-Updates suchen" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Click="CheckLauncherUpdateButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
